#!/bin/sh

# An example hook script to verify what is about to be pushed.  Called by "git
# push" after it has checked the remote status, but before anything has been
# pushed.  If this script exits with a non-zero status nothing will be pushed.
#
# This hook is called with the following parameters:
#
# $1 -- Name of the remote to which the push is being done
# $2 -- URL to which the push is being done
#
# If pushing without using a named remote those arguments will be equal.
#
# Information about the commits which are being pushed is supplied as lines to
# the standard input in the form:
#
#   <local ref> <local sha1> <remote ref> <remote sha1>
#
# This sample shows how to prevent push of commits where the log message starts
# with "WIP" (work in progress).

remote="$1"
url="$2"

z40=0000000000000000000000000000000000000000

# git feeds the refs on stdin and they can only be read once: keep them so the
# repo hook still gets them (without refs, pre-commit checks nothing and exits 0).
refs=$(cat)

printf '%s\n' "$refs" | while read local_ref local_sha remote_ref remote_sha
do
    if [ "$local_sha" = $z40 ]
    then
        # Handle delete
        :
    else
#        echo "$local_ref <-> $local sha1 <-> $remote_ref <-> $remote:sha"
        # Verificamos q no estemos en una rama "master" 13.0, 12.0, ect
        MATCH="^(refs/heads/)+([0-9]{2}\.)+([0-9]{1,2}$)"
        if echo $remote_ref | grep -Eq "$MATCH"; then
            echo "NO HAGAS PUSH A MASTER"
            exit 1
        fi
    fi
done || exit 1

# Si hay un hook local lo ejecutamos, con sus argumentos y sus refs.
common_dir="$(git rev-parse --git-common-dir 2>/dev/null)" || common_dir=""
case "$common_dir" in /*) ;; ?*) common_dir="$(pwd)/$common_dir" ;; esac

HOOK_PATH="$common_dir/hooks/$(basename "$0")"
if [ -n "$common_dir" ] && [ -x "$HOOK_PATH" ]; then
    # Con stdin vacio hay que pasarle EOF, no una linea en blanco: el hook del
    # repo espera lineas de 4 campos y una vacia no es lo mismo que "sin refs".
    if [ -n "$refs" ]; then
        printf '%s\n' "$refs" | "$HOOK_PATH" "$@"
    else
        "$HOOK_PATH" "$@" < /dev/null
    fi
    exit $?
fi
exit 0
